                page_content=item["content"].strip(),
                metadata={
                    "title": item["title"],
                    "category": item["category"],
                    **item["metadata"]
                }
            )
            documents.append(doc)
        
        return documents
    
    def _setup_qa_chain(self):
        """Set up the QA chain with retrieval and custom prompt."""
        if not self.vector_store or not self.llm:
            print("❌ Cannot setup QA chain: Missing vector store or LLM")
            self.qa_chain = None
            return
        
        # Custom prompt template for Aegis-specific responses
        prompt_template = """
        You are the official Aegis Tournament Management assistant, an expert system for esports tournament platform support.
        
        CONTEXT INFORMATION:
        {context}
        
        CONVERSATION HISTORY:
        {chat_history}
        
        SYSTEM CAPABILITIES:
        - Provide accurate information about Aegis tournament platform features
        - Help with tournament creation, management, and participation
        - Explain user roles, permissions, and platform functionality
        - Guide users through team registration and match procedures
        - Clarify API endpoints and technical integration requirements
        - Assist with troubleshooting and platform navigation
        
        RESPONSE GUIDELINES:
        1. Answer only questions related to Aegis tournament management platform
        2. Use the provided context to give accurate, specific information
        3. Be helpful, professional, and actionable in your guidance
        4. If context doesn't fully answer the question, provide what you can and suggest resources
        5. Keep responses focused and comprehensive while being concise
        6. Reference specific features and capabilities from the context when relevant
        7. If asked about unrelated topics, politely redirect to Aegis platform questions
        
        USER QUESTION: {question}
        
        Please provide a helpful, accurate response based on the Aegis platform context:
        """
        
        PROMPT = PromptTemplate(
            template=prompt_template,
            input_variables=["context", "chat_history", "question"]
        )
        
        try:
            # Create retrieval QA chain with memory
            self.qa_chain = RetrievalQA.from_chain_type(
                llm=self.llm,
                chain_type="stuff",
                retriever=self.vector_store.as_retriever(
                    search_type="similarity",
                    search_kwargs={
                        "k": 4,  # Retrieve top 4 most relevant documents
                        "score_threshold": 0.1  # Minimum relevance score
                    }
                ),
                return_source_documents=True,
                chain_type_kwargs={
                    "prompt": PROMPT,
                    "memory": self.memory
                }
            )
            print("🔗 QA chain with retrieval and memory initialized")
        except Exception as e:
            print(f"❌ QA chain setup failed: {e}")
            self.qa_chain = None
    
    @observe(name="aegis_chatbot_query")
    def ask_question(self, question: str, user_context: Dict[str, Any] = None) -> Dict[str, Any]:
        """
        Process user question using RAG-enhanced retrieval and generation.
        Includes LangFuse observability for monitoring and analytics.
        """
        # Set LangFuse context for observability
        if self.langfuse:
            # Note: langfuse_context not available in this version
            pass
        
        try:
            # Validate question relevance
            if not self._is_aegis_related(question):
                return self._create_filtered_response()
            
            # Prepare enhanced question with context
            enhanced_question = self._enhance_question_with_context(question, user_context)
            
            # Process with QA chain if available
            if self.qa_chain:
                result = self.qa_chain.invoke({"query": enhanced_question})
                
                answer = result["result"]
                source_documents = result.get("source_documents", [])
                
                # Format sources for response
                sources = self._format_sources(source_documents)
                
                # Calculate confidence based on retrieval quality
                confidence = self._calculate_confidence(source_documents, answer)
                
                response = {
                    "answer": answer,
                    "sources": sources,
                    "confidence": confidence,
                    "timestamp": datetime.now().isoformat(),
                    "model": "Gemini 2.0 Flash + ChromaDB RAG",
                    "retrieved_docs": len(source_documents),
                    "conversation_id": str(uuid.uuid4())
                }
                
            else:
                # Fallback to direct Gemini service
                response = self._fallback_response(enhanced_question, user_context)
            
            # Log to LangFuse for observability
            if self.langfuse:
                # Note: langfuse_context not available in this version
                pass
            
            return response
            
        except Exception as e:
            print(f"❌ Chatbot error: {e}")
            return {
                "answer": "I encountered an error while processing your question. Please try again or contact support.",
                "sources": [],
                "confidence": 0.0,
                "timestamp": datetime.now().isoformat(),
                "error": str(e)
            }
    
    def _is_aegis_related(self, question: str) -> bool:
        """Enhanced relevance checking for Aegis platform questions."""
        aegis_keywords = [
            # Core platform terms
            "tournament", "team", "match", "player", "competition", "bracket",
            "registration", "organizer", "admin", "spectator", "game", "gaming",
            "esports", "score", "result", "schedule", "draw", "blockchain",
            "aegis", "platform", "api", "endpoint", "authentication", "user",
            
            # Technical terms
            "notification", "email", "websocket", "real-time", "database",
            "jwt", "token", "login", "password", "profile", "role", "permission",
            
            # Tournament specific
            "rule", "format", "elimination", "round robin", "swiss", "playoff",
            "captain", "member", "substitute", "skill", "rank", "leaderboard",
            "prize", "entry fee", "deadline", "check-in", "timeout", "dispute",
            
            # Actions and operations
            "create", "manage", "join", "register", "login", "profile", "chatbot",
            "submit", "update", "delete", "view", "list", "search", "filter"
        ]
        
        question_lower = question.lower()
        
        # Check for Aegis-related keywords
        keyword_matches = sum(1 for keyword in aegis_keywords if keyword in question_lower)
        
        # Check for off-topic indicators
        off_topic_indicators = [
            "weather", "news", "politics", "cooking", "recipe", "movie", "music",
            "celebrity", "stock", "finance", "shopping", "travel", "hotel",
            "restaurant", "health", "medical", "doctor", "therapy", "exercise",
            "homework", "school", "university", "job", "career", "dating",
            "relationship", "fashion", "beauty", "makeup", "car", "vehicle"
        ]
        
        off_topic_matches = sum(1 for topic in off_topic_indicators if topic in question_lower)
        
        # Decision logic: relevant if keywords found and no off-topic content
        return keyword_matches > 0 and off_topic_matches == 0
    
    def _create_filtered_response(self) -> Dict[str, Any]:
        """Create response for filtered/off-topic questions."""
        return {
            "answer": "I'm the Aegis Tournament Management assistant, specialized in helping with esports tournaments, team management, match procedures, and platform features. Please ask me questions related to the Aegis tournament platform, such as how to create tournaments, manage teams, handle matches, or use platform features.",
            "sources": [],
            "confidence": 0.0,
            "timestamp": datetime.now().isoformat(),
            "filtered": True,
            "suggestions": [
                "How do I create a new tournament?",
                "What are the different tournament formats?",
                "How do I register my team?",
                "How does the blockchain draw system work?"
            ]
        }
    
    def _enhance_question_with_context(self, question: str, user_context: Dict[str, Any] = None) -> str:
        """Enhance question with user context for better retrieval."""
        if not user_context:
            return question
        
        context_parts = []
        if user_context.get("role"):
            context_parts.append(f"User role: {user_context['role']}")
        if user_context.get("tournament_id"):
            context_parts.append(f"Tournament context: {user_context['tournament_id']}")
        if user_context.get("team_id"):
            context_parts.append(f"Team context: {user_context['team_id']}")
        
        if context_parts:
            context_string = " | ".join(context_parts)
            return f"Context: {context_string}\n\nQuestion: {question}"
        
        return question
    
    def _format_sources(self, source_documents: List[Document]) -> List[Dict[str, Any]]:
        """Format source documents for response."""
        sources = []
        for doc in source_documents:
            sources.append({
                "title": doc.metadata.get("title", "Aegis Documentation"),
                "content": doc.page_content[:300] + "..." if len(doc.page_content) > 300 else doc.page_content,
                "category": doc.metadata.get("category", "general"),
                "priority": doc.metadata.get("priority", "medium")
            })
        return sources
    
    def _calculate_confidence(self, source_documents: List[Document], answer: str) -> float:
        """Calculate confidence score based on retrieval quality and response."""
        if not source_documents:
            return 0.2
        
        # Base confidence from number of relevant documents
        base_confidence = min(len(source_documents) * 0.2, 0.8)
        
        # Boost for high-priority sources
        priority_boost = sum(0.1 for doc in source_documents 
                           if doc.metadata.get("priority") == "high")
        
        # Boost for detailed response
        length_boost = 0.1 if len(answer) > 200 else 0.05
        
        return min(base_confidence + priority_boost + length_boost, 0.95)
    
    def _fallback_response(self, question: str, user_context: Dict[str, Any] = None) -> Dict[str, Any]:
        """Fallback response using direct Gemini service."""
        try:
            if hasattr(self, 'gemini_service') and self.gemini_service.enabled:
                # Use simple response generation
                response_text = self.gemini_service.generate_simple_match_summary(
                    team1="Aegis", team2="Platform", score1=1, score2=0, duration_minutes=1
                )
                
                return {
                    "answer": f"I'm currently using fallback mode. For questions about the Aegis tournament platform, please refer to the documentation or contact support. Your question: {question}",
                    "sources": [],
                    "confidence": 0.3,
                    "timestamp": datetime.now().isoformat(),
                    "model": "Gemini Fallback",
                    "fallback": True
                }
        except Exception as e:
            print(f"❌ Fallback response failed: {e}")
        
        return {
            "answer": "I'm currently experiencing technical difficulties. Please try again later or contact support for assistance with Aegis platform questions.",
            "sources": [],
            "confidence": 0.1,
            "timestamp": datetime.now().isoformat(),
            "error": "Fallback failed"
        }
    
    def get_conversation_suggestions(self, user_context: Dict[str, Any] = None) -> List[str]:
        """Get contextual conversation suggestions based on user role."""
        base_suggestions = [
            "How do I create a new tournament in Aegis?",
            "What tournament formats are available?",
            "How do I register my team for a competition?",
            "How does the blockchain draw system ensure fairness?",
            "What should I do if there's a technical issue during a match?",
            "How can I view live tournament brackets and results?",
            "What are the different user roles and their permissions?",
            "How do I submit match results and handle disputes?"
        ]
        
        # Add role-specific suggestions
        if user_context and user_context.get("role"):
            role = user_context["role"]
            if role == "ADMIN":
                base_suggestions.extend([
                    "How do I manage user accounts and permissions?",
                    "How do I monitor system status and services?",
                    "How do I configure platform-wide settings?"
                ])
            elif role == "ORGANIZER":
                base_suggestions.extend([
                    "How do I set up tournament rules and formats?",
                    "How do I manage team registrations?",
                    "How do I handle disputes and violations?"
                ])
            elif role == "PLAYER":
                base_suggestions.extend([
                    "How do I join or create a team?",
                    "How do I check my match schedule?",
                    "How do I update my player profile?"
                ])
        
        return base_suggestions[:10]
    
    def add_dynamic_knowledge(self, title: str, content: str, category: str, 
                            metadata: Dict[str, Any] = None) -> Dict[str, Any]:
        """Add new knowledge to the ChromaDB vector store."""
        try:
            doc = Document(
                page_content=content,
                metadata={
                    "title": title,
                    "category": category,
                    "source": "dynamic",
                    "created_at": datetime.now().isoformat(),
                    **(metadata or {})
                }
            )
            
            if self.vector_store:
                # Split and add to vector store
                texts = self.text_splitter.split_documents([doc])
                self.vector_store.add_documents(texts)
                
                return {
                    "status": "success",
                    "message": f"Added knowledge: {title}",
                    "chunks_added": len(texts),
                    "category": category
                }
            else:
                return {
                    "status": "error",
                    "message": "Vector store not available"
                }
                
        except Exception as e:
            return {
                "status": "error",
                "message": f"Failed to add knowledge: {str(e)}"
            }
    
    def get_service_status(self) -> Dict[str, Any]:
        """Get comprehensive service status for monitoring."""
        status = "operational" if self.is_fully_initialized else "degraded"
        if self.initialization_errors:
            status = "error"
            
        return {
            "service": "Aegis RAG-Enhanced Chatbot",
            "status": status,
            "initialization_errors": self.initialization_errors,
            "components": {
                "llm": "Gemini 2.0 Flash" if self.llm else "Fallback Service",
                "vector_store": "ChromaDB" if self.vector_store else "Unavailable",
                "embeddings": "HuggingFace MiniLM" if self.embeddings else "Unavailable",
                "memory": "Conversation Buffer" if self.memory else "Unavailable",
                "observability": "LangFuse" if self.langfuse else "Disabled"
            },
            "capabilities": [
                "RAG-enhanced responses",
                "ChromaDB vector search",
                "Context-aware conversations",
                "Role-based suggestions",
                "Dynamic knowledge updates",
                "Conversation memory",
                "Content filtering",
                "LangFuse observability"
            ],
            "knowledge_base": {
                "status": "loaded",
                "categories": ["platform", "access_control", "tournaments", "team_management", 
                             "match_rules", "blockchain", "api_integration"],
                "vector_store_ready": self.vector_store is not None
            }
        }