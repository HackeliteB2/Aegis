import os
import json
import uuid
from typing import List, Dict, Any, Optional
from datetime import datetime

import chromadb
from langchain.text_splitter import RecursiveCharacterTextSplitter
from langchain_community.vectorstores import Chroma
from langchain_community.embeddings import HuggingFaceEmbeddings
from langchain_google_genai import ChatGoogleGenerativeAI
from langchain.schema import Document
from langchain.chains import RetrievalQA
from langchain.prompts import PromptTemplate
from langchain.memory import ConversationBufferWindowMemory
from langfuse import observe, Langfuse

from app.core.config import settings
from app.services.gemini_service import GeminiService


class AegisRAGChatbotService:
    """
    Advanced RAG-Enhanced Chatbot for Aegis Tournament Management System.
    
    Architecture Components:
    - ChromaDB Vector Store for document embeddings
    - Gemini 2.0 Flash for LLM responses  
    - HuggingFace Embeddings for text vectorization
    - LangChain for orchestration and retrieval
    - LangFuse for observability and monitoring
    - Context-aware responses with conversation memory
    """
    
    def __init__(self):
        """Initialize the RAG chatbot with all components."""
        # Initialize status tracking
        self.initialization_errors = []
        self.is_fully_initialized = False
        
        # Initialize LangFuse for observability
        try:
            self._init_langfuse()
        except Exception as e:
            self.initialization_errors.append(f"LangFuse init error: {str(e)}")
            self.langfuse = None
        
        # Initialize Gemini LLM
        try:
            self._init_gemini_llm()
        except Exception as e:
            self.initialization_errors.append(f"Gemini LLM init error: {str(e)}")
            self.llm = None
        
        # Initialize embeddings
        try:
            self._init_embeddings()
        except Exception as e:
            self.initialization_errors.append(f"Embeddings init error: {str(e)}")
            self.embeddings = None
        
        # Initialize ChromaDB vector store
        try:
            self._init_vector_store()
        except Exception as e:
            self.initialization_errors.append(f"ChromaDB init error: {str(e)}")
            self.vector_store = None
        
        # Initialize text splitter
        try:
            self.text_splitter = RecursiveCharacterTextSplitter(
                chunk_size=1000,
                chunk_overlap=200,
                length_function=len,
                separators=["\n\n", "\n", " ", ""]
            )
        except Exception as e:
            self.initialization_errors.append(f"Text splitter init error: {str(e)}")
            self.text_splitter = None
        
        # Initialize conversation memory
        try:
            self.memory = ConversationBufferWindowMemory(
                k=5,  # Remember last 5 exchanges
                memory_key="chat_history",
                return_messages=True
            )
        except Exception as e:
            self.initialization_errors.append(f"Memory init error: {str(e)}")
            self.memory = None
        
        # Initialize knowledge base and QA chain
        try:
            self._initialize_knowledge_base()
        except Exception as e:
            self.initialization_errors.append(f"Knowledge base init error: {str(e)}")
            
        try:
            self._setup_qa_chain()
        except Exception as e:
            self.initialization_errors.append(f"QA chain init error: {str(e)}")
            self.qa_chain = None
        
        # Set initialization status
        self.is_fully_initialized = len(self.initialization_errors) == 0
        if self.initialization_errors:
            print(f"⚠️  Chatbot initialized with {len(self.initialization_errors)} errors:")
            for error in self.initialization_errors:
                print(f"  - {error}")
        else:
            print("✅ Chatbot fully initialized successfully!")
        
        print("🤖 Aegis RAG Chatbot initialized successfully!")
        print(f"✅ ChromaDB Vector Store: Ready")
        print(f"✅ Gemini 2.0 Flash LLM: {'Ready' if self.llm else 'Failed'}")
        print(f"✅ HuggingFace Embeddings: {'Ready' if self.embeddings else 'Failed'}")
        print(f"✅ LangFuse Observability: {'Ready' if self.langfuse else 'Failed'}")
    
    def _init_langfuse(self):
        """Initialize LangFuse for observability and monitoring."""
        try:
            # LangFuse configuration (you can set these in environment)
            self.langfuse = Langfuse(
                public_key=os.getenv("LANGFUSE_PUBLIC_KEY", ""),
                secret_key=os.getenv("LANGFUSE_SECRET_KEY", ""),
                host=os.getenv("LANGFUSE_HOST", "https://cloud.langfuse.com")
            )
            print("🔍 LangFuse observability initialized")
        except Exception as e:
            print(f"⚠️ LangFuse init failed (optional): {e}")
            self.langfuse = None
    
    def _init_gemini_llm(self):
        """Initialize Gemini 2.0 Flash LLM via LangChain."""
        try:
            if settings.GOOGLE_GEMINI_API_KEY and settings.GOOGLE_GEMINI_API_KEY != "your-google-gemini-api-key":
                self.llm = ChatGoogleGenerativeAI(
                    model="gemini-2.0-flash-exp",
                    google_api_key=settings.GOOGLE_GEMINI_API_KEY,
                    temperature=0.1,  # Lower temperature for more consistent responses
                    max_tokens=2048,
                    top_p=0.8
                )
                print("🧠 Gemini 2.0 Flash LLM initialized via LangChain")
            else:
                # Fallback to direct Gemini service
                self.gemini_service = GeminiService()
                self.llm = None
                print("🧠 Using fallback Gemini service")
        except Exception as e:
            print(f"❌ Gemini LLM init failed: {e}")
            self.llm = None
            self.gemini_service = GeminiService()
    
    def _init_embeddings(self):
        """Initialize HuggingFace embeddings for document vectorization."""
        try:
            self.embeddings = HuggingFaceEmbeddings(
                model_name="sentence-transformers/all-MiniLM-L6-v2",
                model_kwargs={'device': 'cpu'},
                encode_kwargs={'normalize_embeddings': True}
            )
            print("📊 HuggingFace embeddings initialized")
        except Exception as e:
            print(f"❌ Embeddings init failed: {e}")
            self.embeddings = None
    
    def _init_vector_store(self):
        """Initialize ChromaDB vector store."""
        try:
            # Create persistent ChromaDB client
            self.chroma_client = chromadb.PersistentClient(path="./aegis_chroma_db")
            
            # Initialize collection for Aegis knowledge
            self.collection_name = "aegis_knowledge"
            
            if self.embeddings:
                self.vector_store = Chroma(
                    client=self.chroma_client,
                    collection_name=self.collection_name,
                    embedding_function=self.embeddings,
                    persist_directory="./aegis_chroma_db"
                )
                print("🗄️ ChromaDB vector store initialized")
            else:
                print("❌ Vector store init failed: No embeddings")
                self.vector_store = None
        except Exception as e:
            print(f"❌ ChromaDB init failed: {e}")
            self.vector_store = None
    
    def _initialize_knowledge_base(self):
        """Initialize comprehensive Aegis knowledge base."""
        try:
            knowledge_docs = self._create_aegis_knowledge_documents()
            
            if self.vector_store and knowledge_docs:
                # Check if collection already has documents
                try:
                    collection = self.chroma_client.get_collection(self.collection_name)
                    doc_count = collection.count()
                    
                    if doc_count == 0:
                        # Add documents to vector store
                        texts = self.text_splitter.split_documents(knowledge_docs)
                        self.vector_store.add_documents(texts)
                        print(f"📚 Added {len(texts)} knowledge chunks to ChromaDB")
                    else:
                        print(f"📚 Knowledge base already loaded: {doc_count} documents")
                        
                except Exception:
                    # Collection doesn't exist, create it
                    texts = self.text_splitter.split_documents(knowledge_docs)
                    self.vector_store.add_documents(texts)
                    print(f"📚 Created knowledge base with {len(texts)} chunks")
            
        except Exception as e:
            print(f"❌ Knowledge base init failed: {e}")
    
